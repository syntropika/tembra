{
  "name": "@tembra/testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./src/conformance.ts"
  },
  "scripts": {
    "typecheck": "bun --bun x --no-install tsc -p tsconfig.json",
    "test": "bun run --cwd ../../packages/sdk build && bun run test:unit && bun run test:package && bun run test:tooling && bun run test:node",
    "test:node": "bun run prepare:node && node --import ./scripts/require-node.ts --expose-gc --test test/node/*.test.ts",
    "test:browser": "bun run prepare:browser && bun scripts/test-browser.ts",
    "test:unit": "bun test test/*.test.ts",
    "test:package": "bun run --cwd ../../packages/sdk build && bun test test/package/*.test.ts",
    "test:tooling": "bun run prepare:tooling && bun run --cwd ../../packages/sdk build && bun test test/tooling/*.test.ts --timeout 30000",
    "prepare:node": "bun run --cwd ../../packages/sdk build && node ../../packages/sdk/scripts/build-bindings.ts native --debug",
    "prepare:browser": "bun run --cwd ../../packages/sdk build && node ../../packages/sdk/scripts/build-bindings.ts wasm --debug",
    "prepare:tooling": "bun scripts/prepare-tooling.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@tembra/sdk": "workspace:*"
  }
}
