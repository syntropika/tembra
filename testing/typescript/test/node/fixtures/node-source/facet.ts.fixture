import { Type, defineFacet, defineHook, hookHandler, local, method, native, opaque, registerHook } from "@tembra/sdk";
import { step, leafPayload } from "./middle.mjs";
import { bonus } from "installed-dependency";

declare global {
  var __tembraSourceTest: { capability: object; closed: number; wait: () => Promise<void>; observe?: (read: () => number) => void };
}
const Bias = local("test.source.bias", { version: 1, input: Type.Object({}), members: { read: method(undefined, Type.Integer()) } });
export const Hook = defineHook("test.source.hook", { version: 1, strategy: "waterfall", input: Type.Integer() });
const Contributor = local("test.source.contributor", { version: 1, input: Type.Object({}), members: { run: Hook.method } });
export const Capability = native<object>("test.source.capability@1");
export const Counter = local("test.source.counter", { version: 1, input: Type.Object({}), members: {
  count: Type.Integer(), increment: method(undefined, Type.Integer()), hook: method(Type.Integer(), Type.Integer()),
  wait: method(undefined, Type.Integer()), value: opaque<object>(Capability.native),
} });
const payload: number[] = Array.from({ length: 50_000 }, () => step);
const read = (): number => payload[0]! + leafPayload[0]! - step;
globalThis.__tembraSourceTest.observe?.(read);
export default defineFacet({ name: "source-counter", uses: [Bias], setup(scope, declaration) {
  declaration.serve(Counter, (_input, self) => {
    const count = self.cell("count", { schema: Type.Integer(), initial: 0 });
    const bias = self.get(Bias, {});
    const value = self.resource("capability", { open: () => globalThis.__tembraSourceTest.capability,
      close() { globalThis.__tembraSourceTest.closed += 1; } });
    return { state: { count }, opaque: { value }, methods: {
      async increment(context) { count.replace(context, count.value + read()); return count.value + bonus + await bias.read(context); },
      async hook(_context, input) { return await scope.root(context => scope.runHook(Hook, context, input)); },
      async wait() { await globalThis.__tembraSourceTest.wait(); return read(); },
    } };
  });
  declaration.serve(Contributor, (_input, self) => {
    registerHook(self, Hook, "add", "run");
    return { state: {}, methods: { run: hookHandler(Hook, (_context, args) => args.input + step) } };
  }, { lifetime: "host" });
} });
