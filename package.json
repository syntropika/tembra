{
  "name": "tembra-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test packages/sdk/test --timeout 15000",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "bun --bun x --no-install oxlint --disable-nested-config --deny-warnings --report-unused-disable-directives",
    "lint:fix": "bun --bun x --no-install oxlint --disable-nested-config --fix --deny-warnings",
    "format": "node node_modules/oxfmt/bin/oxfmt .",
    "format:check": "node node_modules/oxfmt/bin/oxfmt --check ."
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
