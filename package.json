{
  "name": "tembra-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun run --bun --workspaces --if-present --sequential test",
    "typecheck": "bun --bun x --no-install tsc -p tsconfig.json && bun run --bun --workspaces --if-present --sequential typecheck",
    "lint": "bun --bun x --no-install oxlint --disable-nested-config --deny-warnings --report-unused-disable-directives",
    "lint:fix": "bun --bun x --no-install oxlint --disable-nested-config --fix --deny-warnings",
    "format": "bun --bun x --no-install oxfmt .",
    "format:check": "bun --bun x --no-install oxfmt --check ."
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "5.9.3"
  },
  "overrides": {
    "json-schema-to-typescript>@apidevtools/json-schema-ref-parser": "16.0.5"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
