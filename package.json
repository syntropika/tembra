{
  "name": "@syntropika/tembra-sdk",
  "version": "0.2.2",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/ts/sdk",
    "packages/ts/engine-node",
    "packages/ts/engine-wasm",
    "packages/ts/react-native",
    "examples/wasm-orb"
  ],
  "files": [
    "packages/ts/sdk/src",
    "packages/ts/sdk/dist"
  ],
  "type": "module",
  "imports": {
    "#tembra-adapters": {
      "source": "./packages/ts/sdk/src/runtime/adapters.ts",
      "bun": "./packages/ts/sdk/src/runtime/adapters.ts",
      "types": "./packages/ts/sdk/dist/runtime/adapters.d.ts",
      "browser": "./packages/ts/sdk/src/runtime/adapters.ts",
      "default": "./packages/ts/sdk/dist/runtime/adapters.js"
    }
  },
  "exports": {
    ".": {
      "tembra-wasm": {
        "source": "./packages/ts/sdk/src/guest.ts",
        "bun": "./packages/ts/sdk/src/guest.ts",
        "types": "./packages/ts/sdk/dist/guest.d.ts",
        "browser": "./packages/ts/sdk/dist/guest.js",
        "default": "./packages/ts/sdk/dist/guest.js"
      },
      "source": "./packages/ts/sdk/src/index.ts",
      "bun": "./packages/ts/sdk/src/index.ts",
      "types": "./packages/ts/sdk/dist/index.d.ts",
      "browser": "./packages/ts/sdk/dist/index.js",
      "import": "./packages/ts/sdk/dist/index.js"
    },
    "./node": {
      "source": "./packages/ts/sdk/src/node.ts",
      "bun": "./packages/ts/sdk/src/node.ts",
      "types": "./packages/ts/sdk/dist/node.d.ts",
      "browser": "./packages/ts/sdk/dist/node.js",
      "import": "./packages/ts/sdk/dist/node.js"
    },
    "./browser": {
      "source": "./packages/ts/sdk/src/browser.ts",
      "bun": "./packages/ts/sdk/src/browser.ts",
      "types": "./packages/ts/sdk/dist/browser.d.ts",
      "browser": "./packages/ts/sdk/dist/browser.js",
      "import": "./packages/ts/sdk/dist/browser.js"
    },
    "./runtime": {
      "source": "./packages/ts/sdk/src/host.ts",
      "bun": "./packages/ts/sdk/src/host.ts",
      "types": "./packages/ts/sdk/dist/host.d.ts",
      "browser": "./packages/ts/sdk/dist/host.js",
      "import": "./packages/ts/sdk/dist/host.js"
    },
    "./tooling": {
      "source": "./packages/ts/sdk/src/tooling/index.ts",
      "bun": "./packages/ts/sdk/src/tooling/index.ts",
      "types": "./packages/ts/sdk/dist/tooling/index.d.ts",
      "browser": "./packages/ts/sdk/dist/tooling/index.js",
      "import": "./packages/ts/sdk/dist/tooling/index.js"
    },
    "./msgpack": {
      "source": "./packages/ts/sdk/src/msgpack.ts",
      "bun": "./packages/ts/sdk/src/msgpack.ts",
      "types": "./packages/ts/sdk/dist/msgpack.d.ts",
      "browser": "./packages/ts/sdk/dist/msgpack.js",
      "import": "./packages/ts/sdk/dist/msgpack.js"
    },
    "./coordinator": {
      "source": "./packages/ts/sdk/src/coordinator.ts",
      "bun": "./packages/ts/sdk/src/coordinator.ts",
      "types": "./packages/ts/sdk/dist/coordinator.d.ts",
      "browser": "./packages/ts/sdk/dist/coordinator.js",
      "import": "./packages/ts/sdk/dist/coordinator.js"
    },
    "./manager": {
      "source": "./packages/ts/sdk/src/manager.ts",
      "bun": "./packages/ts/sdk/src/manager.ts",
      "types": "./packages/ts/sdk/dist/manager.d.ts",
      "browser": "./packages/ts/sdk/dist/manager.js",
      "import": "./packages/ts/sdk/dist/manager.js"
    },
    "./rpc": {
      "source": "./packages/ts/sdk/src/rpc.ts",
      "bun": "./packages/ts/sdk/src/rpc.ts",
      "types": "./packages/ts/sdk/dist/rpc.d.ts",
      "browser": "./packages/ts/sdk/dist/rpc.js",
      "import": "./packages/ts/sdk/dist/rpc.js"
    },
    "./telemetry": {
      "source": "./packages/ts/sdk/src/telemetry.ts",
      "bun": "./packages/ts/sdk/src/telemetry.ts",
      "types": "./packages/ts/sdk/dist/telemetry.d.ts",
      "browser": "./packages/ts/sdk/dist/telemetry.js",
      "import": "./packages/ts/sdk/dist/telemetry.js"
    },
    "./http": {
      "source": "./packages/ts/sdk/src/http.ts",
      "bun": "./packages/ts/sdk/src/http.ts",
      "types": "./packages/ts/sdk/dist/http.d.ts",
      "browser": "./packages/ts/sdk/dist/http.js",
      "import": "./packages/ts/sdk/dist/http.js"
    }
  },
  "scripts": {
    "lint": "bun --bun x --no-install oxlint --config packages/ts/oxlint.config.ts --disable-nested-config --deny-warnings --report-unused-disable-directives",
    "lint:fix": "bun --bun x --no-install oxlint --config packages/ts/oxlint.config.ts --disable-nested-config --fix --deny-warnings",
    "format": "node node_modules/oxfmt/bin/oxfmt --config packages/ts/oxfmt.config.ts .",
    "format:check": "node node_modules/oxfmt/bin/oxfmt --config packages/ts/oxfmt.config.ts --check .",
    "typecheck": "bun --bun x --no-install tsc -p packages/ts/tsconfig.json && bun run --cwd packages/ts/react-native typecheck",
    "test:browser": "bun packages/ts/test/browser.ts"
  },
  "dependencies": {
    "@syntropika/tembra-engine-node": "0.2.2",
    "@syntropika/tembra-engine-wasm": "0.2.2",
    "enhanced-resolve": "5.26.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002"
  },
  "optionalDependencies": {
    "@msgpack/msgpack": "3.1.3"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.3"
}
