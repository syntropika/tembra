package example:readings;

interface capabilities {
    use tembra:runtime/context@0.1.0.{invocation};
    enum failure { forbidden, unavailable, cancelled }
    record response { status: u16, body: string }
    record progress { stage: string, message: string }
    get: func(context: borrow<invocation>, path: string) -> result<response, failure>;
    publish: func(context: borrow<invocation>, event: progress) -> result<_, failure>;
}

interface analysis {
    use tembra:runtime/context@0.1.0.{invocation};
    record request { path: string, threshold: f64 }
    record report {
        station: string,
        count: u32,
        mean: f64,
        median: f64,
        minimum: f64,
        maximum: f64,
        alert: bool,
        calibration: f64,
    }
    run: func(context: borrow<invocation>, input: request) -> result<report, string>;
}

world orb {
    import tembra:runtime/context@0.1.0;
    import capabilities;
    export analysis;
}
