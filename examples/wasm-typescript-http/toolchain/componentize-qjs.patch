index 0000000..db3b310
--- /dev/null
+++ b/crates/runtime/src/prepared.rs
@@ -0,0 +1,320 @@
+//! Stable synchronous import arguments and complete imported-resource preflight.
+//!
+//! User getters run while preparing private values. Resource state is checked
+//! only after all preparation finishes; lowering then reads inert data properties.
+use crate::tagged::decode_tagged;
+use crate::typed_array::TypedArrayExt;
+use crate::{DetHashMap, resources::validate_imported_resource, trivia::fn_lookup};
+use rquickjs::{Array, BigInt, Ctx, Exception, Object, TypedArray, Value};
+use smallvec::SmallVec;
+use wit_dylib_ffi::{Resource, Type};
+
+struct Use<'js> {
+    ty: Resource,
+    value: Value<'js>,
+    owned: bool,
+}
+
+pub(crate) fn arguments<'js>(
+    ctx: &Ctx<'js>,
+    types: impl Iterator<Item = Type>,
+    args: SmallVec<[Value<'js>; 8]>,
+) -> rquickjs::Result<SmallVec<[Value<'js>; 8]>> {
+    let types: Vec<_> = types.collect();
+    let mut uses = Vec::new();
+    let mut prepared = SmallVec::new();
+    for (ty, value) in types.into_iter().zip(args) {
+        prepared.push(snapshot(ctx, ty, value, &mut uses, 0)?);
+    }
+    let mut seen = DetHashMap::default();
+    for entry in uses {
+        let handle = validate_imported_resource(entry.ty, &entry.value, entry.owned)?;
+        if let Some(was_owned) = seen.insert((entry.ty.index(), handle), entry.owned)
+            && (was_owned || entry.owned)
+        {
+            return Err(Exception::throw_type(
+                ctx,
+                "a transferred resource cannot appear in another position of the same call",
+            ));
+        }
+    }
+    Ok(prepared)
+}
+fn object<'js>(ctx: &Ctx<'js>) -> rquickjs::Result<Object<'js>> {
+    Object::new_proto(ctx.clone(), None)
+}
+fn array<'js>(ctx: &Ctx<'js>) -> rquickjs::Result<Array<'js>> {
+    let result = Array::new(ctx.clone())?;
+    result.as_object().set_prototype(None)?;
+    Ok(result)
+}
+fn tagged<'js>(
+    ctx: &Ctx<'js>,
+    tag: &str,
+    value: Option<Value<'js>>,
+) -> rquickjs::Result<Value<'js>> {
+    let result = object(ctx)?;
+    result.set("tag", tag)?;
+    if let Some(value) = value {
+        result.set("val", value)?;
+    }
+    Ok(result.into_value())
+}
+fn unalias(mut ty: Type) -> Type {
+    while let Type::Alias(alias) = ty {
+        ty = alias.ty();
+    }
+    ty
+}
+fn snapshot<'js>(
+    ctx: &Ctx<'js>,
+    ty: Type,
+    value: Value<'js>,
+    uses: &mut Vec<Use<'js>>,
+    depth: usize,
+) -> rquickjs::Result<Value<'js>> {
+    if depth > 128 {
+        return Err(Exception::throw_type(
+            ctx,
+            "import argument nesting limit exceeded",
+        ));
+    }
+    let resolved = unalias(ty);
+    match resolved {
+        Type::Own(ty) | Type::Borrow(ty) => {
+            if ty.new().is_some() {
+                return Err(Exception::throw_type(
+                    ctx,
+                    "experimental import preparation does not support guest-defined resources",
+                ));
+            }
+            rquickjs::class::Class::<crate::resources::ImportedResource>::from_value(&value)
+                .map_err(|_| Exception::throw_type(ctx, "expected an imported resource wrapper"))?;
+            uses.push(Use {
+                ty,
+                value: value.clone(),
+                owned: matches!(resolved, Type::Own(_)),
+            });
+            Ok(value)
+        }
+        Type::Record(record) => {
+            let input = value
+                .as_object()
+                .ok_or_else(|| Exception::throw_type(ctx, "expected record object"))?;
+            let result = object(ctx)?;
+            for (name, ty) in record.fields().rev() {
+                let key = fn_lookup(ctx, name);
+                let field = input.get::<_, Value>(key)?;
+                result.set(key, snapshot(ctx, ty, field, uses, depth + 1)?)?;
+            }
+            Ok(result.into_value())
+        }
+        Type::Tuple(tuple) => {
+            let input = value
+                .as_array()
+                .ok_or_else(|| Exception::throw_type(ctx, "expected tuple array"))?;
+            let result = array(ctx)?;
+            for (index, ty) in tuple.types().enumerate().rev() {
+                result.set(
+                    index,
+                    snapshot(ctx, ty, input.get(index)?, uses, depth + 1)?,
+                )?;
+            }
+            Ok(result.into_value())
+        }
+        Type::List(list) => {
+            macro_rules! copy_array {
+                ($t:ty) => {
+                    if let Some(input) = value.as_object().and_then(|o| o.as_typed_array::<$t>()) {
+                        let (buffer, len) = input.copy_to_buffer(std::mem::align_of::<$t>())?;
+                        // The checked buffer is aligned, owned and cannot run JS.
+                        let items =
+                            unsafe { std::slice::from_raw_parts(buffer.ptr().cast::<$t>(), len) };
+                        return Ok(TypedArray::<$t>::new(ctx.clone(), items.to_vec())?.into_value());
+                    }
+                };
+            }
+            // Match the lowering ABI's exact typed-array fast-path dispatch.
+            match list.ty() {
+                Type::U8 => copy_array!(u8),
+                Type::S8 => copy_array!(i8),
+                Type::U16 => copy_array!(u16),
+                Type::S16 => copy_array!(i16),
+                Type::U32 => copy_array!(u32),
+                Type::S32 => copy_array!(i32),
+                Type::U64 => copy_array!(u64),
+                Type::S64 => copy_array!(i64),
+                Type::F32 => copy_array!(f32),
+                Type::F64 => copy_array!(f64),
+                _ => {}
+            }
+            let input = value
+                .as_array()
+                .ok_or_else(|| Exception::throw_type(ctx, "expected list array"))?;
+            // Array::len assumes a small tagged integer; read large lengths fallibly.
+            let len = input.as_object().get::<_, f64>("length")?;
+            if !len.is_finite() || !(0.0..=u32::MAX as f64).contains(&len) || len.fract() != 0.0 {
+                return Err(Exception::throw_type(ctx, "invalid list length"));
+            }
+            let len = len as usize;
+            let result = array(ctx)?;
+            for index in 0..len {
+                result.set(
+                    index,
+                    snapshot(ctx, list.ty(), input.get(index)?, uses, depth + 1)?,
+                )?;
+            }
+            Ok(result.into_value())
+        }
+        Type::Variant(variant) => {
+            let (index, payload) = decode_tagged(
+                ctx,
+                value,
+                "variant",
+                variant.cases().map(|(name, ty)| (name, ty.is_some())),
+            )?;
+            let (name, ty) = variant.cases().nth(index).unwrap();
+            let payload = match (ty, payload) {
+                (Some(ty), Some(value)) => Some(snapshot(ctx, ty, value, uses, depth + 1)?),
+                _ => None,
+            };
+            tagged(ctx, name, payload)
+        }
+        Type::Option(option) => {
+            if matches!(unalias(option.ty()), Type::Option(_)) {
+                let (index, payload) = decode_tagged(
+                    ctx,
+                    value,
+                    "nested option",
+                    [("none", false), ("some", true)],
+                )?;
+                let payload = payload
+                    .map(|value| snapshot(ctx, option.ty(), value, uses, depth + 1))
+                    .transpose()?;
+                tagged(ctx, if index == 0 { "none" } else { "some" }, payload)
+            } else if value.is_null() || value.is_undefined() {
+                Ok(Value::new_null(ctx.clone()))
+            } else {
+                snapshot(ctx, option.ty(), value, uses, depth + 1)
+            }
+        }
+        Type::Result(result) => {
+            let (index, payload) = decode_tagged(
+                ctx,
+                value,
+                "result",
+                [
+                    ("ok", result.ok().is_some()),
+                    ("err", result.err().is_some()),
+                ],
+            )?;
+            let ty = if index == 0 {
+                result.ok()
+            } else {
+                result.err()
+            };
+            let payload = match (ty, payload) {
+                (Some(ty), Some(value)) => Some(snapshot(ctx, ty, value, uses, depth + 1)?),
+                _ => None,
+            };
+            tagged(ctx, if index == 0 { "ok" } else { "err" }, payload)
+        }
+        Type::Flags(flags) => {
+            let input = value
+                .as_object()
+                .ok_or_else(|| Exception::throw_type(ctx, "expected flags object"))?;
+            let result = object(ctx)?;
+            for name in flags.names() {
+                let key = fn_lookup(ctx, name);
+                let value: Value = input.get(key)?;
+                let flag = if value.is_undefined() {
+                    false
+                } else {
+                    value
+                        .as_bool()
+                        .ok_or_else(|| Exception::throw_type(ctx, "expected boolean flag"))?
+                };
+                result.set(key, flag)?;
+            }
+            Ok(result.into_value())
+        }
+        Type::Enum(enum_) => {
+            let name = value.get::<String>()?;
+            if !enum_.names().any(|n| n == name) {
+                return Err(Exception::throw_type(ctx, "unknown enum case"));
+            }
+            Ok(value)
+        }
+        Type::Bool => {
+            if value.as_bool().is_none() {
+                return Err(Exception::throw_type(ctx, "expected bool"));
+            }
+            Ok(value)
+        }
+        Type::U8 | Type::S8 | Type::U16 | Type::S16 | Type::U32 | Type::S32 => {
+            let number = value
+                .get::<f64>()
+                .map_err(|_| Exception::throw_type(ctx, "expected integer number"))?;
+            let (min, max) = match resolved {
+                Type::U8 => (0.0, u8::MAX as f64),
+                Type::S8 => (i8::MIN as f64, i8::MAX as f64),
+                Type::U16 => (0.0, u16::MAX as f64),
+                Type::S16 => (i16::MIN as f64, i16::MAX as f64),
+                Type::U32 => (0.0, u32::MAX as f64),
+                Type::S32 => (i32::MIN as f64, i32::MAX as f64),
+                _ => unreachable!(),
+            };
+            if !number.is_finite() || number.fract() != 0.0 || !(min..=max).contains(&number) {
+                return Err(Exception::throw_type(ctx, "integer outside its WIT range"));
+            }
+            Ok(value)
+        }
+        Type::F32 | Type::F64 => {
+            value.get::<f64>()?;
+            Ok(value)
+        }
+        Type::U64 | Type::S64 => {
+            if !value.is_big_int() {
+                return Err(Exception::throw_type(ctx, "expected bigint"));
+            }
+            let raw = ctx.as_raw().as_ptr();
+            let canonical = unsafe {
+                if matches!(resolved, Type::U64) {
+                    let mut number = 0;
+                    if rquickjs::qjs::JS_ToBigUint64(raw, &mut number, value.as_raw()) != 0 {
+                        return Err(rquickjs::Error::Exception);
+                    }
+                    BigInt::from_u64(ctx.clone(), number)?.into_value()
+                } else {
+                    let mut number = 0;
+                    if rquickjs::qjs::JS_ToBigInt64(raw, &mut number, value.as_raw()) != 0 {
+                        return Err(rquickjs::Error::Exception);
+                    }
+                    BigInt::from_i64(ctx.clone(), number)?.into_value()
+                }
+            };
+            if !unsafe { rquickjs::qjs::JS_IsStrictEqual(raw, value.as_raw(), canonical.as_raw()) }
+            {
+                return Err(Exception::throw_type(ctx, "bigint outside its WIT range"));
+            }
+            Ok(value)
+        }
+        Type::Char => {
+            value.get::<char>()?;
+            Ok(value)
+        }
+        Type::String => {
+            value.get::<String>()?;
+            Ok(value)
+        }
+        Type::Map(_)
+        | Type::FixedLengthList(_)
+        | Type::Future(_)
+        | Type::Stream(_)
+        | Type::ErrorContext => Err(Exception::throw_type(
+            ctx,
+            "type not supported by experimental synchronous import preparation",
+        )),
+        Type::Alias(_) => unreachable!(),
+    }
+}
