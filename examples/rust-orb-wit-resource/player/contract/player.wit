package example:player@1.0.0;

/// The service: plays a few frames through one session of the decoder.
interface playback {
  /// Decode `frames` with one session keyed by `key`, and return the first byte of each
  /// decoded frame, then how many frames the session counted.
  play: func(key: u8, frames: list<list<u8>>) -> list<u32>;
}

world player {
  import example:decoder/decoding@1.0.0;
  export playback;
}

package example:decoder@1.0.0 {
  /// The service: opens sessions and counts the ones destroyed.
  interface decoding {
    /// One decoding session: the caller owns it and decodes frame after frame with it.
    resource session {
      constructor(key: u8);
      /// Decode one frame: here, undo an exclusive-or with the key; a method of the resource.
      decode: func(frame: list<u8>) -> list<u8>;
      /// How many frames this session decoded so far.
      frames: func() -> u32;
    }

    /// Open a session for `key`; the caller owns the returned handle.
    open: func(key: u8) -> session;

    /// How many sessions were destroyed, when their last owner dropped them.
    closed: func() -> u32;
  }
  world decoder {
    export decoding;
  }
}
