package example:counter@1.0.0;

/// A count the kernel keeps for each counter object.
interface counter {
    record count {
        total: s64,
        steps: u32,
    }

    /// Add `by` and return the new count, or the refusal when the total would go below zero;
    /// the kernel then keeps the previous count.
    add: func(by: s64) -> result<count, string>;

    /// The count so far.
    read: func() -> count;
}

world tally {
    export counter;
}
