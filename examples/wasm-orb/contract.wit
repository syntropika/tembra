package example:integrated@1.0.0;

interface arithmetic {
    double: func(value: s32) -> s32;
}

interface calculation {
    record input { values: list<s32> }
    sum: async func(input: input) -> s32;
    read: func() -> s32;
    resource-value: func() -> s32;
    fetch-and-sum: async func(url: string) -> s32;
}

world arithmetic-provider { export arithmetic; }
world calculator {
    import arithmetic;
    export calculation;
}

world online-calculator {
    import arithmetic;
    import wasi:http/client@0.3.0;
    export calculation;
}
