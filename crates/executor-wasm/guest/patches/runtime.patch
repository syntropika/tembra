+/// Why a JS value cannot be lowered to a checked WIT scalar.
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum Invalid {
+    /// The JS value has the wrong type; recoverable imports throw `TypeError`.
+    Type(&'static str),
+    /// The value has the right type but no exact WIT value; imports throw `RangeError`.
+    Range(&'static str),
+}
+
+impl Invalid {
+    fn message(self) -> &'static str {
+        match self {
+            Self::Type(message) | Self::Range(message) => message,
+        }
+    }
+}
+
+/// Accept only finite integral Numbers inside `min..=max`, without coercion.
+fn check_number(value: &Value<'_>, min: f64, max: f64) -> Result<f64, Invalid> {
+    let number = value
+        .as_number()
+        .ok_or(Invalid::Type("expected a number"))?;
+    if number.is_finite() && number.fract() == 0.0 && number >= min && number <= max {
+        Ok(number)
+    } else {
+        Err(Invalid::Range(
+            "integer value is outside its declared WIT range",
+        ))
+    }
+}
+
+/// Read signed 128-bit words without allocation, coercion or modular narrowing.
+fn check_bigint(value: &Value<'_>) -> Result<(u64, u64), Invalid> {
+    if !value.is_big_int() {
+        return Err(Invalid::Type("expected a bigint"));
+    }
+    let mut low = 0;
+    let mut high = 0;
+    // A BigInt operand runs no JavaScript; nonzero means it does not fit in 128 bits.
+    let status = unsafe {
+        rquickjs::qjs::JS_ToBigInt128Sat(
+            value.ctx().as_raw().as_ptr(),
+            &mut low,
+            &mut high,
+            value.as_raw(),
+        )
+    };
+    if status == 0 {
+        Ok((low, high))
+    } else {
+        Err(Invalid::Range("bigint is outside its declared WIT range"))
+    }
+}
+
+fn check_u64(value: &Value<'_>) -> Result<u64, Invalid> {
+    match check_bigint(value)? {
+        (low, 0) => Ok(low),
+        _ => Err(Invalid::Range(
+            "u64 value is outside its declared WIT range",
+        )),
+    }
+}
+
+fn check_s64(value: &Value<'_>) -> Result<i64, Invalid> {
+    let (low, high) = check_bigint(value)?;
+    let result = low as i64;
+    let sign = if result < 0 { u64::MAX } else { 0 };
+    if high == sign {
+        Ok(result)
+    } else {
+        Err(Invalid::Range(
+            "s64 value is outside its declared WIT range",
+        ))
+    }
+}
+
+fn check_float(value: &Value<'_>) -> Result<f64, Invalid> {
+    // NaN, infinities and f32 rounding are valid WIT float semantics.
+    value.as_number().ok_or(Invalid::Type("expected a number"))
+}
+
+fn check_char(value: &Value<'_>) -> Result<char, Invalid> {
+    const MESSAGE: &str = "expected a string holding exactly one Unicode scalar value";
+    let text = value
+        .as_string()
+        .and_then(|text| text.to_string().ok())
+        .ok_or(Invalid::Type(MESSAGE))?;
+    let mut chars = text.chars();
+    match (chars.next(), chars.next()) {
+        (Some(c), None) => Ok(c),
+        _ => Err(Invalid::Type(MESSAGE)),
+    }
+}
+
+/// Lowering cannot report errors: an invalid export result or changed import argument traps.
+fn checked<T>(result: Result<T, Invalid>) -> T {
+    result.unwrap_or_else(|invalid| panic!("{}", invalid.message()))
+}
+
+fn checked_number(value: &Value<'_>, min: f64, max: f64) -> f64 {
+    checked(check_number(value, min, max))
+}
+
+/// Whether lowering `ty` can reach a checked scalar.
+fn has_checked_scalar(ty: Type) -> bool {
+    match ty {
+        Type::U8 | Type::U16 | Type::U32 | Type::U64 => true,
+        Type::S8 | Type::S16 | Type::S32 | Type::S64 => true,
+        Type::F32 | Type::F64 | Type::Char => true,
+        // Lowering an invalid stream or future would trap after earlier arguments moved.
+        Type::Stream(_) | Type::Future(_) => true,
+        Type::Alias(alias) => has_checked_scalar(alias.ty()),
+        Type::Record(record) => record.fields().any(|(_, ty)| has_checked_scalar(ty)),
+        Type::Tuple(tuple) => tuple.types().any(has_checked_scalar),
+        Type::List(list) => has_checked_scalar(list.ty()),
+        Type::Option(option) => has_checked_scalar(option.ty()),
+        Type::Result(result) => result
+            .ok()
+            .into_iter()
+            .chain(result.err())
+            .any(has_checked_scalar),
+        Type::Variant(variant) => variant
+            .cases()
+            .any(|(_, ty)| ty.is_some_and(has_checked_scalar)),
+        _ => false,
+    }
+}
+
+/// Accept exactly the values `pop_stream`/`pop_future` lower: an idle endpoint of this type, an
+/// iterable (stream) or thenable (future) during an async call, or a raw `u32` handle.
+fn validate_endpoint<'js>(
+    ctx: &rquickjs::Ctx<'js>,
+    value: &Value<'js>,
+    type_index: u32,
+    stream: bool,
+) -> rquickjs::Result<()> {
+    let end = if stream {
+        Class::<StreamReadable>::from_value(value)
+            .map(|class| class.borrow().end.check_transfer(type_index))
+            .or_else(|_| {
+                Class::<StreamWritable>::from_value(value)
+                    .map(|class| class.borrow().end.check_transfer(type_index))
+            })
+    } else {
+        Class::<FutureReadable>::from_value(value)
+            .map(|class| class.borrow().end.check_transfer(type_index))
+            .or_else(|_| {
+                Class::<FutureWritable>::from_value(value)
+                    .map(|class| class.borrow().end.check_transfer(type_index))
+            })
+    };
+    if let Ok(end) = end {
+        return end.map_err(rquickjs::Error::from);
+    }
+    let kind = if stream { "stream" } else { "future" };
+    let source = if stream { is_iterable(ctx, value)? } else { is_thenable(value)? };
+    if source {
+        if !ctx.task().is_active() {
+            return Err(rquickjs::Exception::throw_type(
+                ctx,
+                &format!("WIT {kind} lowering requires an active async call"),
+            ));
+        }
+        return Ok(());
+    }
+    if check_number(value, 0.0, u32::MAX as f64).is_ok() {
+        return Ok(());
+    }
+    let source = if stream { "an iterable or async iterable" } else { "a thenable" };
+    Err(rquickjs::Exception::throw_type(
+        ctx,
+        &format!("expected a WIT {kind}, {source}"),
+    ))
+}
+
+/// Validate every checked scalar an import argument would lower, without lowering it.
+///
+/// This follows the same JS shapes as the `pop_*` methods below and throws a
+/// recoverable `TypeError` or `RangeError` before the host is called. It only
+/// descends into subtrees that contain a checked scalar. Lowering re-checks
+/// every scalar, so a getter returning a different value later still traps.
+pub(crate) fn validate_import_arg<'js>(
+    ctx: &rquickjs::Ctx<'js>,
+    ty: Type,
+    value: &Value<'js>,
+) -> rquickjs::Result<()> {
+    if !has_checked_scalar(ty) {
+        return Ok(());
+    }
+    let invalid = |invalid: Invalid| match invalid {
+        Invalid::Type(message) => rquickjs::Exception::throw_type(ctx, message),
+        Invalid::Range(message) => rquickjs::Exception::throw_range(ctx, message),
+    };
+    let shape =
+        |expected: &str| rquickjs::Exception::throw_type(ctx, &format!("expected {expected}"));
+    match ty {
+        Type::U8 => check_number(value, u8::MIN as f64, u8::MAX as f64).map(drop),
+        Type::S8 => check_number(value, i8::MIN as f64, i8::MAX as f64).map(drop),
+        Type::U16 => check_number(value, u16::MIN as f64, u16::MAX as f64).map(drop),
+        Type::S16 => check_number(value, i16::MIN as f64, i16::MAX as f64).map(drop),
+        Type::U32 => check_number(value, u32::MIN as f64, u32::MAX as f64).map(drop),
+        Type::S32 => check_number(value, i32::MIN as f64, i32::MAX as f64).map(drop),
+        Type::U64 => check_u64(value).map(drop),
+        Type::S64 => check_s64(value).map(drop),
+        Type::F32 | Type::F64 => check_float(value).map(drop),
+        Type::Char => check_char(value).map(drop),
+        Type::Stream(stream) => return validate_endpoint(ctx, value, stream.index() as u32, true),
+        Type::Future(future) => return validate_endpoint(ctx, value, future.index() as u32, false),
+        Type::Alias(alias) => return validate_import_arg(ctx, alias.ty(), value),
+        Type::Record(record) => {
+            let object = value.as_object().ok_or_else(|| shape("an object"))?;
+            for (name, ty) in record.fields() {
+                if has_checked_scalar(ty) {
+                    let field: Value = object.get(fn_lookup(ctx, name))?;
+                    validate_import_arg(ctx, ty, &field)?;
+                }
+            }
+            return Ok(());
+        }
+        Type::Tuple(tuple) => {
+            let array = value.as_array().ok_or_else(|| shape("an array"))?;
+            for (index, ty) in tuple.types().enumerate() {
+                if has_checked_scalar(ty) {
+                    let element: Value = array.get(index)?;
+                    validate_import_arg(ctx, ty, &element)?;
+                }
+            }
+            return Ok(());
+        }
+        Type::List(list) => {
+            let element_ty = list.ty();
+            // `maybe_pop_list` accepts only the exact typed array, whose elements are valid.
+            if let Some(object) = value.as_object() {
+                let exact = match element_ty {
+                    Type::U8 => object.as_typed_array::<u8>().is_some(),
+                    Type::S8 => object.as_typed_array::<i8>().is_some(),
+                    Type::U16 => object.as_typed_array::<u16>().is_some(),
+                    Type::S16 => object.as_typed_array::<i16>().is_some(),
+                    Type::U32 => object.as_typed_array::<u32>().is_some(),
+                    Type::S32 => object.as_typed_array::<i32>().is_some(),
+                    Type::U64 => object.as_typed_array::<u64>().is_some(),
+                    Type::S64 => object.as_typed_array::<i64>().is_some(),
+                    Type::F32 => object.as_typed_array::<f32>().is_some(),
+                    Type::F64 => object.as_typed_array::<f64>().is_some(),
+                    _ => false,
+                };
+                if exact {
+                    return Ok(());
+                }
+            }
+            let array = value.as_array().ok_or_else(|| shape("an array"))?;
+            for index in 0..array.len() {
+                let element: Value = array.get(index)?;
+                validate_import_arg(ctx, element_ty, &element)?;
+            }
+            return Ok(());
+        }
+        Type::Option(option) => {
+            let payload = if option_is_nested(option) {
+                decode_tagged(
+                    ctx,
+                    value.clone(),
+                    "nested option",
+                    [("none", false), ("some", true)],
+                )?
+                .1
+            } else if value.is_null() || value.is_undefined() {
+                None
+            } else {
+                Some(value.clone())
+            };
+            return match payload {
+                Some(payload) => validate_import_arg(ctx, option.ty(), &payload),
+                None => Ok(()),
+            };
+        }
+        Type::Result(result) => {
+            let cases = [result.ok(), result.err()];
+            let (case, payload) = decode_tagged(
+                ctx,
+                value.clone(),
+                "result",
+                [("ok", cases[0].is_some()), ("err", cases[1].is_some())],
+            )?;
+            return match (cases[case], payload) {
+                (Some(ty), Some(payload)) => validate_import_arg(ctx, ty, &payload),
+                _ => Ok(()),
+            };
+        }
+        Type::Variant(variant) => {
+            let cases = variant.cases().map(|(name, ty)| (name, ty.is_some()));
+            let (case, payload) = decode_tagged(ctx, value.clone(), "variant", cases)?;
+            let ty = variant.cases().nth(case).and_then(|(_, ty)| ty);
+            return match (ty, payload) {
+                (Some(ty), Some(payload)) => validate_import_arg(ctx, ty, &payload),
+                _ => Ok(()),
+            };
+        }
+        _ => Ok(()),
+    }
+    .map_err(invalid)
+}
