+//! Callback entry and promise quiescence.
+//!
+//! QuickJS has one job queue per runtime. Without a boundary rule, a continuation
+//! created by export call A could run while export call B is entered and use B's
+//! host authority. This engine fires promise hooks only around thenable jobs,
+//! not around ordinary reaction jobs, so a per-job check is impossible without
+//! forking the engine. Instead every callback that completes an export (sync
+//! return, async exit, module initialization) must leave:
+//!
+//! - an empty job queue, and
+//! - no reachable pending promise.
+//!
+//! A reaction can only run after its source promise settles. If every reachable
+//! promise is settled when a callback completes, any later reaction is queued and
+//! drained inside the callback that registered or settled it. The check is on the
+//! source promise, which is always a real promise, so species constructors and
+//! thenables cannot bypass it.
+//!
+//! Promises are tracked through the INIT hook with `WeakRef`s, which never keep a
+//! promise alive. Epochs are bookkeeping and diagnostics; they grant no authority.
+#![allow(unsafe_code)]
+
+use std::cell::{Cell, RefCell};
+
+use rquickjs::function::This;
+use rquickjs::promise::PromiseHookType;
+use rquickjs::{Constructor, Ctx, Function, JsLifetime, Object, Persistent, Runtime, Value};
+
+use crate::module::execute_pending_job;
+use crate::resources::drain_resource_drops;
+
+/// Which callback, if any, may run JavaScript.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Entry {
+    /// Wizer-time module evaluation: no host authority.
+    Bootstrap,
+    /// No export callback is entered.
+    Idle,
+    /// An export callback with its epoch is entered.
+    Export(u64),
+}
+
+pub(crate) struct Quiescence {
+    entry: Cell<Entry>,
+    last_epoch: Cell<u64>,
+    /// An async export task waits for host events between callbacks.
+    suspended: Cell<bool>,
+    weak_ref: Persistent<Constructor<'static>>,
+    deref: Persistent<Function<'static>>,
+    /// `WeakRef`s to promises that may still be pending.
+    promises: RefCell<Vec<Persistent<Object<'static>>>>,
+    prune_at: Cell<usize>,
+}
+
+// SAFETY: only `Persistent` values of the owning runtime are stored.
+unsafe impl<'js> JsLifetime<'js> for Quiescence {
+    type Changed<'to> = Quiescence;
+}
+
+const PRUNE_MIN: usize = 256;
+
+/// Install the hook before any context exists. It is inert until [`install`].
+pub(crate) fn install_hook(runtime: &Runtime) {
+    runtime.set_promise_hook(Some(Box::new(|ctx, kind, promise, _parent| {
+        let Some(state) = ctx.userdata::<Quiescence>() else {
+            return;
+        };
+        match kind {
+            PromiseHookType::Init => {
+                if state.entry.get() == Entry::Idle {
+                    panic!("JavaScript created a promise outside an export callback");
+                }
+                state.track(&ctx, promise);
+            }
+            PromiseHookType::Before if state.entry.get() == Entry::Idle => {
+                panic!("JavaScript job ran outside an export callback");
+            }
+            _ => {}
+        }
+    })));
+}
+
+/// Capture intrinsics and remove `FinalizationRegistry` before any shim or user code.
+///
+/// Finalization callbacks are queued by the collector at arbitrary points, so they
+/// could run in a later callback than the one that registered them.
+pub(crate) fn install(ctx: &Ctx<'_>) {
+    let globals = ctx.globals();
+    let weak_ref: Constructor = globals.get("WeakRef").expect("WeakRef intrinsic");
+    let prototype: Object = weak_ref.get("prototype").expect("WeakRef prototype");
+    let deref: Function = prototype.get("deref").expect("WeakRef.prototype.deref");
+    globals
+        .remove("FinalizationRegistry")
+        .expect("Failed to remove FinalizationRegistry");
+    ctx.store_userdata(Quiescence {
+        entry: Cell::new(Entry::Bootstrap),
+        last_epoch: Cell::new(0),
+        suspended: Cell::new(false),
+        weak_ref: Persistent::save(ctx, weak_ref),
+        deref: Persistent::save(ctx, deref),
+        promises: RefCell::default(),
+        prune_at: Cell::new(PRUNE_MIN),
+    })
+    .unwrap_or_else(|_| panic!("Failed to store quiescence state"));
+}
+
+fn state<'a>(ctx: &'a Ctx<'_>) -> rquickjs::runtime::UserDataGuard<'a, Quiescence> {
+    ctx.userdata().expect("quiescence state not installed")
+}
+
+impl Quiescence {
+    fn track<'js>(&self, ctx: &Ctx<'js>, promise: Value<'js>) {
+        let weak_ref = self.weak_ref.clone().restore(ctx).expect("WeakRef restore");
+        let weak: Object = weak_ref
+            .construct((promise,))
+            .expect("Failed to track promise");
+        let len = {
+            let mut promises = self.promises.borrow_mut();
+            promises.push(Persistent::save(ctx, weak));
+            promises.len()
+        };
+        if len >= self.prune_at.get() {
+            let pending = self.prune(ctx);
+            self.prune_at.set((pending * 2).max(PRUNE_MIN));
+        }
+    }
+
+    /// Drop collected or settled promises and return how many remain pending.
+    fn prune(&self, ctx: &Ctx<'_>) -> usize {
+        let deref = self.deref.clone().restore(ctx).expect("deref restore");
+        let tracked = std::mem::take(&mut *self.promises.borrow_mut());
+        let mut pending = Vec::new();
+        for weak in tracked {
+            let object = weak.clone().restore(ctx).expect("WeakRef restore");
+            let target: Value = deref.call((This(object),)).expect("WeakRef deref");
+            let state =
+                unsafe { rquickjs::qjs::JS_PromiseState(ctx.as_raw().as_ptr(), target.as_raw()) };
+            if state == rquickjs::qjs::JSPromiseStateEnum_JS_PROMISE_PENDING {
+                pending.push(weak);
+            }
+        }
+        let mut promises = self.promises.borrow_mut();
+        // `deref` creates no promises, but keep anything tracked meanwhile.
+        pending.append(&mut promises);
+        *promises = pending;
+        promises.len()
+    }
+
+    /// Count reachable pending promises, collecting cycles only when needed.
+    fn reachable_pending(&self, ctx: &Ctx<'_>) -> usize {
+        if self.prune(ctx) == 0 {
+            return 0;
+        }
+        ctx.run_gc();
+        self.prune(ctx)
+    }
+}
+
+/// Enter an export callback. Callbacks are serialized: no other may be active.
+pub(crate) fn enter(ctx: &Ctx<'_>) -> u64 {
+    let state = state(ctx);
+    assert_eq!(
+        state.entry.get(),
+        Entry::Idle,
+        "export entered while another callback is active"
+    );
+    assert!(
+        !state.suspended.get(),
+        "export entered while another async export task is suspended"
+    );
+    assert!(
+        !ctx.runtime_is_job_pending(),
+        "JavaScript job was queued outside an export callback"
+    );
+    let epoch = state.last_epoch.get() + 1;
+    state.last_epoch.set(epoch);
+    state.entry.set(Entry::Export(epoch));
+    epoch
+}
+
+/// Re-enter a suspended async export with its original epoch.
+pub(crate) fn resume(ctx: &Ctx<'_>, epoch: u64) {
+    let state = state(ctx);
+    assert_eq!(state.entry.get(), Entry::Idle, "async callback re-entered");
+    assert!(state.suspended.replace(false), "no suspended async export");
+    assert!(
+        !ctx.runtime_is_job_pending(),
+        "JavaScript job was queued outside an export callback"
+    );
+    state.entry.set(Entry::Export(epoch));
+}
+
+/// Return to the host while the async export still owns pending waitables.
+pub(crate) fn suspend(ctx: &Ctx<'_>) {
+    assert!(
+        !ctx.runtime_is_job_pending(),
+        "suspending with queued JavaScript jobs"
+    );
+    let state = state(ctx);
+    state.entry.set(Entry::Idle);
+    state.suspended.set(true);
+}
+
+/// Run every queued job inside the current callback.
+pub(crate) fn drain_jobs(ctx: &Ctx<'_>) {
+    while execute_pending_job(ctx).expect("QuickJS job failed") {
+        drain_resource_drops(ctx);
+    }
+}
+
+/// Complete an export callback: no queued job and no reachable pending promise.
+pub(crate) fn leave(ctx: &Ctx<'_>, what: &str) {
+    assert!(
+        !ctx.runtime_is_job_pending(),
+        "{what} left queued JavaScript jobs"
+    );
+    let state = state(ctx);
+    assert!(
+        matches!(state.entry.get(), Entry::Export(_)),
+        "{what} completed outside its callback"
+    );
+    let pending = state.reachable_pending(ctx);
+    assert!(
+        pending == 0,
+        "{what} left {pending} pending promise(s); work that could only resume in a later \
+         callback is refused"
+    );
+    state.entry.set(Entry::Idle);
+}
+
+/// Close module evaluation: run its jobs, then refuse any leftover unjoined work.
+pub(crate) fn finish_bootstrap(ctx: &Ctx<'_>) -> Result<(), String> {
+    while execute_pending_job(ctx).map_err(|e| format!("JavaScript module job failed: {e}"))? {
+        drain_resource_drops(ctx);
+    }
+    let state = state(ctx);
+    assert_eq!(
+        state.entry.get(),
+        Entry::Bootstrap,
+        "module evaluated twice"
+    );
+    let pending = state.reachable_pending(ctx);
+    if pending != 0 {
+        return Err(format!(
+            "module initialization left {pending} pending promise(s); \
+             work cannot be resumed by a later call"
+        ));
+    }
+    state.entry.set(Entry::Idle);
+    Ok(())
+}
+
+/// Refuse a WIT import while no export callback is entered.
+pub(crate) fn require_export(ctx: &Ctx<'_>, name: &str) {
+    match state(ctx).entry.get() {
+        Entry::Export(_) => {}
+        Entry::Bootstrap => {
+            panic!(
+                "WIT import `{name}` called during module initialization; host authority is closed"
+            )
+        }
+        Entry::Idle => panic!("WIT import `{name}` called outside an export callback"),
+    }
+}
+
+/// Host-initiated cleanup runs no export; it must not leave JavaScript work behind.
+pub(crate) fn assert_no_jobs(ctx: &Ctx<'_>, what: &str) {
+    assert!(
+        !ctx.runtime_is_job_pending(),
+        "{what} queued JavaScript work outside an export callback"
+    );
+}
+
+trait JobQueue {
+    fn runtime_is_job_pending(&self) -> bool;
+}
+
+impl JobQueue for Ctx<'_> {
+    fn runtime_is_job_pending(&self) -> bool {
+        unsafe {
+            rquickjs::qjs::JS_IsJobPending(rquickjs::qjs::JS_GetRuntime(self.as_raw().as_ptr()))
+                != 0
+        }
+    }
+}
