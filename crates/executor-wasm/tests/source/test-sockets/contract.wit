package test:sockets;

interface net {
    /// Send PING, read the first chunk, then send ACK; report the first chunk and everything.
    fetch: async func(port: u16) -> string;
    /// Drop the socket, then read its receive stream to the end.
    alive: async func(port: u16) -> string;
    /// Abandon a pending read the way the component runtime requires (cancel it, wait for it to
    /// settle), then drop the stream, its completion future and the socket.
    abandon: async func(port: u16) -> bool;
    /// Wait for data that never comes, dropping everything in `finally`. A read the host revokes
    /// is this call's business error, so the revision keeps serving.
    hold: async func(port: u16) -> result<bool, string>;
    /// Whether connecting to the port is refused.
    forbidden: async func(port: u16) -> bool;
}

world app {
    import wasi:sockets/types@0.3.0;
    export net;
}
