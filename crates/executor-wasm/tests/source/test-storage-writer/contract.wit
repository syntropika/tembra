package test:storage@1.0.0;

/// Files under the Orb's granted mounts. A refused path or filesystem call is a business error:
/// the standard `error-code` tag, or why the path has no mount.
interface files {
    read: async func(path: string) -> result<string, string>;
    write: async func(path: string, content: string) -> result<_, string>;
}

world storage {
    import wasi:filesystem/types@0.3.0;
    import wasi:filesystem/preopens@0.3.0;
    export files;
}
