package example:hooks@1.0.0;

/// Waterfall hook: each participant transforms the admission in plan order.
interface guard {
    record admission {
        value: s32,
        blocked: bool,
    }
    apply: func(input: admission) -> admission;
}

/// Series hook: every participant observes the input; the hook itself returns nothing.
interface audit {
    apply: func(input: s32);
}

/// Bail hook: `none` lets the next participant decide; the first `some` ends the plan.
interface choice {
    apply: func(input: s32) -> option<s32>;
}

/// The provider's service, which runs its hooks.
interface runner {
    use guard.{admission};
    run: func(input: admission) -> admission;
    audit: func(input: s32);
    choose: func(input: s32) -> option<s32>;
}

/// Each contributor reports what its own participants observed.
interface reporter {
    record counts {
        audit: s32,
        choices: s32,
    }
    read: func() -> counts;
}

world provider {
    export guard;
    export audit;
    export choice;
    export runner;
}
