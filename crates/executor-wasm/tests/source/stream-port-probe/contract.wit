package tembra-test:port-refusal@1.0.0;

interface math {
    double: func(value: u8) -> u8;
}

interface probe {
    /// A typed-import refusal inside the guest (see `orb.ts`); returns what happened.
    forge: async func(which: u32) -> string;
    ping: func() -> u32;
}

world orb {
    import math;
    export probe;
}
