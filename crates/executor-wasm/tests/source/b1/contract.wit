package tembra-test:b1@1.0.0;

/// Callback association probes for one serialized source revision.
interface probe {
    /// Return at once; a detached timer continuation records what it observed when it ran.
    detach: async func(milliseconds: u32);
    /// The principal or outcome the last detached continuation recorded.
    observed: func() -> string;
    /// Leave a continuation that no host operation will ever settle.
    park: async func();
    /// Settle a parked continuation from this call.
    poke: async func() -> string;
}

world b1 {
    export probe;
}
