package test:standard;

/// Standard filesystem and clock calls under kernel admission and cancellation.
interface checks {
    /// Open and retain the granted `bytes` file; return its size.
    open: async func() -> string;
    /// The retained descriptor's size.
    size: async func() -> string;
    /// Log `standard:waiting`, then wait a minute on the monotonic clock. A wait the host revokes
    /// (rejected or ended early) is this call's business error, so the revision keeps serving.
    hold: async func() -> result<string, string>;
    /// Return while 127 filesystem calls are still admitted.
    abandon: async func() -> string;
    /// 96 concurrent filesystem calls.
    burst: async func() -> string;
}

world app {
    import wasi:filesystem/types@0.3.0;
    import wasi:filesystem/preopens@0.3.0;
    import wasi:clocks/monotonic-clock@0.3.0;
    export checks;
}
