package tembra-test:streams@1.0.0;

interface frames {
    /// `count` chunks of `size` bytes; byte j of chunk i is (i + j) mod 256.
    frames: async func(count: u32, size: u32, mode: u32) -> stream<u8>;
    ping: func(value: u32) -> u32;
}

/// Forwards the imported stream as this Orb's own whole result.
interface relayed {
    /// Returns the imported stream itself.
    frames: async func(count: u32, size: u32, mode: u32) -> stream<u8>;
    /// Copies the imported stream's chunks into a new stream (`writeChunks(readChunks(..))`).
    chunked: async func(count: u32, size: u32, mode: u32) -> stream<u8>;
}

world relay-orb {
    import frames;
    export relayed;
}
