package example:safety-causal;

/// Provided natively; the provider tries to create an object of the calling Orb.
interface bridge {
    bounce: async func() -> result<u32, string>;
}

interface checks {
    /// Call `bridge.bounce` from inside this call and return its outcome.
    reenter: async func() -> result<u32, string>;
    /// This object's state value.
    read: func() -> u32;
}

world test {
    import bridge;
    export checks;
}
