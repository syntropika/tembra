package test:builtins-granted;

interface checks {
    /// What the ambient JavaScript clock and random built-ins observe, as JSON.
    probe: func() -> string;
    /// The public standard system clock: `seconds,nanoseconds`.
    wall: func() -> string;
    /// The public standard insecure seed: `low,high`.
    seed: func() -> string;
}

/// Public clock and random imports; installation requires the Clocks and Random grants.
world app {
    import wasi:clocks/system-clock@0.3.0;
    import wasi:random/insecure-seed@0.3.0;
    export checks;
}
