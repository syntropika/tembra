package tembra:runtime@0.4.0;

interface execution {
    record outcome {
        value: result<string, string>,
        interrupted: bool,
    }
    record effect {
        id: u64,
        packet: string,
    }
    record completion {
        id: u64,
        value: result<string, string>,
    }
    record progress {
        outcome: option<outcome>,
        effects: list<effect>,
    }
}

/// The host owns waits; the interpreter retains continuations in its isolated heap.
world interpreter {
    use execution.{outcome, completion, progress};
    import host-sync: func(packet: string) -> result<string, string>;
    export load: func(source: string) -> outcome;
    export declare: func(packet: string) -> outcome;
    export start: func(packet: string) -> progress;
    export resume: func(completed: list<completion>) -> progress;
    export cancel: func() -> outcome;
    export capture: func() -> result<list<u8>, string>;
}
