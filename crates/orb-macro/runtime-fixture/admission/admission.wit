package example:admission@1.0.0;

/// What the hook `guard` answers, in an interface of its own, which `guard` uses.
interface types {
  /// What a contributor answers: the admission's fields under another name, which the waterfall
  /// accepts as the input's type.
  record verdict {
    value: s32,
    blocked: bool,
  }
}

/// Each contributor may change the admission or block it, in plan order.
interface guard {
  use types.{verdict};

  /// One admission.
  record admission {
    value: s32,
    blocked: bool,
  }

  apply: func(input: admission) -> verdict;
}
