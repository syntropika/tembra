{
  "name": "@syntropika/tembra-sdk",
  "version": "0.2.2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntropika/tembra.git",
    "directory": "packages/ts/sdk"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "imports": {
    "#tembra-adapters": {
      "source": "./src/runtime/adapters.ts",
      "bun": "./src/runtime/adapters.ts",
      "types": "./dist/runtime/adapters.d.ts",
      "browser": "./src/runtime/adapters.ts",
      "default": "./dist/runtime/adapters.js"
    }
  },
  "exports": {
    ".": {
      "tembra-wasm": {
        "source": "./src/guest.ts",
        "bun": "./src/guest.ts",
        "types": "./dist/guest.d.ts",
        "browser": "./dist/guest.js",
        "default": "./dist/guest.js"
      },
      "source": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "bun": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "browser": "./dist/node.js",
      "import": "./dist/node.js"
    },
    "./browser": {
      "source": "./src/browser.ts",
      "bun": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/browser.js"
    },
    "./runtime": {
      "source": "./src/host.ts",
      "bun": "./src/host.ts",
      "types": "./dist/host.d.ts",
      "browser": "./dist/host.js",
      "react-native": "./dist/host.js",
      "import": "./dist/host.js"
    },
    "./tooling": {
      "source": "./src/tooling/index.ts",
      "bun": "./src/tooling/index.ts",
      "types": "./dist/tooling/index.d.ts",
      "browser": "./dist/tooling/index.js",
      "import": "./dist/tooling/index.js"
    },
    "./msgpack": {
      "source": "./src/msgpack.ts",
      "bun": "./src/msgpack.ts",
      "types": "./dist/msgpack.d.ts",
      "browser": "./dist/msgpack.js",
      "import": "./dist/msgpack.js"
    },
    "./coordinator": {
      "source": "./src/coordinator.ts",
      "bun": "./src/coordinator.ts",
      "types": "./dist/coordinator.d.ts",
      "browser": "./dist/coordinator.js",
      "import": "./dist/coordinator.js"
    },
    "./manager": {
      "source": "./src/manager.ts",
      "bun": "./src/manager.ts",
      "types": "./dist/manager.d.ts",
      "browser": "./dist/manager.js",
      "import": "./dist/manager.js"
    },
    "./rpc": {
      "source": "./src/rpc.ts",
      "bun": "./src/rpc.ts",
      "types": "./dist/rpc.d.ts",
      "browser": "./dist/rpc.js",
      "import": "./dist/rpc.js"
    },
    "./telemetry": {
      "source": "./src/telemetry.ts",
      "bun": "./src/telemetry.ts",
      "types": "./dist/telemetry.d.ts",
      "browser": "./dist/telemetry.js",
      "import": "./dist/telemetry.js"
    },
    "./http": {
      "source": "./src/http.ts",
      "bun": "./src/http.ts",
      "types": "./dist/http.d.ts",
      "browser": "./dist/http.js",
      "import": "./dist/http.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build.ts",
    "typecheck": "bun --bun x --no-install tsc -p tsconfig.json",
    "test": "bun test test --timeout 15000",
    "test:node": "node --test test/node.test.mjs test/typed-services.node.test.mjs test/interpreter.node.test.mjs test/component.node.test.mjs"
  },
  "dependencies": {
    "@bytecodealliance/jco-transpile": "0.23.0",
    "@syntropika/tembra-engine-node": "workspace:*",
    "@syntropika/tembra-engine-wasm": "workspace:*",
    "enhanced-resolve": "5.26.0",
    "eventsource-parser": "4.1.3",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@msgpack/msgpack": "3.1.3"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.3"
}
