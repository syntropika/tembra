package example:filesystem@1.0.0;

interface scenario {
    roundtrip: async func() -> string;
    /// The same scenario with a declared failure lane: a refused WASI call reports its
    /// `error-code` tag as `err`.
    roundtrip-checked: async func() -> result<string, string>;
}

world filesystem {
    import wasi:filesystem/types@0.3.0;
    import wasi:filesystem/preopens@0.3.0;
    export scenario;
}
