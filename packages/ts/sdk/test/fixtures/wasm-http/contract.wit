package example:http@1.0.0;

interface requests {
    record reply {
        status: u16,
        text: string,
        duplicate-count: u32,
        trailer: option<string>,
    }
    inspect: async func(url: string) -> reply;
    exchange: async func(url: string) -> reply;
    duplex: async func(url: string) -> string;
    upload: async func(url: string, chunks: u32, fail: bool) -> string;
    interrupt: async func(url: string, observed: string) -> string;
    open: async func(url: string) -> u16;
    read: async func() -> string;
    /// The same read with a declared failure lane: "no response" is a recoverable err.
    read-checked: async func() -> result<string, string>;
    /// A request whose refusal (an ungranted origin) is caught: its error-code reaches the err lane.
    attempt: async func(url: string, upload: bool) -> result<string, string>;
    close: async func();
}

world client {
    import wasi:http/client@0.3.0;
    export requests;
}
