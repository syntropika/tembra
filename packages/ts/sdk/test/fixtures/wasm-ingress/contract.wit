package example:ingress@1.0.0;

/// A dependency the handler calls after its response head was published.
interface ledger {
    note: async func(entry: string) -> u32;
    entries: async func() -> list<string>;
}

world provider {
    export ledger;
}

world handler {
    import ledger;
    export wasi:http/handler@0.3.0;
}

world handler-only {
  export wasi:http/handler@0.3.0;
}
