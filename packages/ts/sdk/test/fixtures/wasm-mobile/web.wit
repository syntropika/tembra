package tembra-mobile:web@1.0.0;

interface web {
    /// Fetch `url`, read the body up to the first blank line or its end, then close the
    /// response. Returns `status|content-type|text`; a failed or revoked request is a
    /// recoverable `err` with its message.
    first: async func(url: string) -> result<string, string>;
    /// The same request without a failure lane: an uncaught failure traps the revision.
    strict: async func(url: string) -> string;
}

world client {
    import wasi:http/client@0.3.0;
    export web;
}
