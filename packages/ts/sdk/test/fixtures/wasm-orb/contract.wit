package example:integrated@1.0.0;

interface arithmetic {
    double: func(value: s32) -> s32;
}

interface calculation {
    record input { values: list<s32> }
    sum: async func(input: input) -> s32;
    read: func() -> s32;
    resource-value: func() -> s32;
    fail: func() -> s32;
    recover: func() -> s32;
    checked: func(value: s32) -> result<s32, string>;
    forbidden: func() -> s32;
    malformed: func() -> s32;
    race: async func() -> s32;
    fanout: async func() -> s32;
    pending: async func() -> s32;
}

interface network {
    /// Strict: a failure (for example a cancelled send) traps and quarantines the revision.
    fetch-and-sum: async func(url: string) -> s32;
    /// The same request with a declared failure lane: a cancelled send is recoverable.
    fetch-and-sum-checked: async func(url: string) -> result<s32, string>;
    first-event: async func(url: string) -> string;
}

world arithmetic-provider { export arithmetic; }
world calculator {
    import arithmetic;
    export calculation;
}

world online-calculator {
    import arithmetic;
    import wasi:http/client@0.3.0;
    export network;
}
