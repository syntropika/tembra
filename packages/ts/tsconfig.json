{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "customConditions": ["source"],
    "paths": {
      "wasi:http/client@0.3.0": ["./sdk/.tembra/wasi/interfaces/wasi-http-client.d.ts"],
      "wasi:http/types@0.3.0": ["./sdk/.tembra/wasi/interfaces/wasi-http-types.d.ts"]
    }
  },
  "include": [
    "sdk/src/**/*.ts",
    "sdk/test/**/*.ts",
    "*/build.ts",
    "*.config.ts",
    "test/**/*.ts",
    "../swift/build.ts",
    "../kotlin/build.ts",
    "../../scripts/**/*.ts",
    "../../crates/executor-wasm/guest/build.ts"
  ],
  "exclude": ["**/dist", "**/node_modules", "**/test/fixtures/**"]
}
