{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "sdk/src/**/*.ts",
    "sdk/test/**/*.ts",
    "*/build.ts",
    "*.config.ts",
    "test/**/*.ts",
    "../swift/build.ts",
    "../kotlin/build.ts",
    "../../scripts/**/*.ts"
  ],
  "exclude": ["**/dist", "**/node_modules"]
}
