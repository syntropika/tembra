{
  "name": "tembra-typescript",
  "private": true,
  "workspaces": [
    "sdk",
    "engine-node",
    "engine-wasm"
  ],
  "type": "module",
  "scripts": {
    "lint": "bun --bun x --no-install oxlint --disable-nested-config --deny-warnings --report-unused-disable-directives",
    "lint:fix": "bun --bun x --no-install oxlint --disable-nested-config --fix --deny-warnings",
    "format": "cd ../.. && node packages/ts/node_modules/oxfmt/bin/oxfmt --config packages/ts/oxfmt.config.ts .",
    "format:check": "cd ../.. && node packages/ts/node_modules/oxfmt/bin/oxfmt --config packages/ts/oxfmt.config.ts --check .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.3"
}
