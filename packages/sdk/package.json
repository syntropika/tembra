{
  "name": "@tembra/sdk",
  "version": "0.1.0",
  "files": [
    "dist/src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser/index.d.ts",
      "import": "./dist/src/browser/index.js"
    }
  },
  "scripts": {
    "build": "bun --bun x --no-install tsc -p tsconfig.json",
    "typecheck": "bun --bun x --no-install tsc -p tsconfig.json --noEmit",
    "test": "bun test test/*.test.ts --timeout 30000"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "es-module-lexer": "3.0.3",
    "jsonc-parser": "3.3.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
