{
  "name": "@tembra/sdk",
  "version": "0.2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./runtime": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./tooling": {
      "types": "./dist/tooling/index.d.ts",
      "import": "./dist/tooling/index.js"
    },
    "./msgpack": {
      "types": "./dist/msgpack.d.ts",
      "import": "./dist/msgpack.js"
    },
    "./coordinator": {
      "types": "./dist/coordinator.d.ts",
      "import": "./dist/coordinator.js"
    },
    "./manager": {
      "types": "./dist/manager.d.ts",
      "import": "./dist/manager.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    },
    "./embedded-runtime": "./dist/embedded.js"
  },
  "scripts": {
    "build": "bun scripts/build-sdk.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test test --timeout 15000",
    "build:native": "node scripts/build-bindings.ts native",
    "build:wasm": "node scripts/build-bindings.ts wasm"
  },
  "dependencies": {
    "enhanced-resolve": "5.26.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@msgpack/msgpack": "3.1.3"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=22"
  }
}
