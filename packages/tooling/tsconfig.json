{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"],
    "types": ["bun"],
    "verbatimModuleSyntax": true,
    "noImplicitAny": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "build.ts", "bin/**/*.ts"]
}
